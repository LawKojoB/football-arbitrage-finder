# Copy this file to ".env" and fill in your real values.
# The app works WITHOUT an API key — it falls back to realistic mock data.

# Get a free key at https://the-odds-api.com (500 requests/month free tier).
ODDS_API_KEY=

# Which sport to pull. Common values:
#   soccer_epl, soccer_uefa_champs_league, soccer_spain_la_liga,
#   soccer_germany_bundesliga, soccer_italy_serie_a, soccer_france_ligue_one
# Comma-separate to pull several.
ODDS_API_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga

# Server port
PORT=4000

# How often to refresh odds from the upstream API (seconds).
# Keep this >= 30 to respect free-tier rate limits.
REFRESH_INTERVAL_SECONDS=30

# Set to "true" to force mock data even if a key is set (useful for development).
USE_MOCK_DATA=false
